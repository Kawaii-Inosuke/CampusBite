# Copy this file to .env and fill in the values. Never commit .env.
# Supabase -> Connect -> "Session pooler" connection string (append ?sslmode=require)
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# development locally (http://localhost works), production on Render
FLASK_ENV=production

# Optional: only for image upload from the staff menu page
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=menu-images
